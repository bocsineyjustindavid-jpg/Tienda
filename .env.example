# Copia este archivo como ".env" y cambia TODOS los valores.
# Nunca subas el archivo .env a internet ni a GitHub.

# Cadena larga y aleatoria (mínimo 32 caracteres). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Credenciales del administrador (se crea solo la primera vez que inicia el servidor)
ADMIN_USER=admin
# Mínimo 12 caracteres, con letras y números
ADMIN_PASS=

# Número de WhatsApp con código de país, solo dígitos (ej. Guatemala: 502XXXXXXXX)
WHATSAPP_NUMBER=

STORE_NAME=Mi Tienda de Ropa
PORT=3000

# Pon "production" cuando lo publiques (con HTTPS)
NODE_ENV=development
